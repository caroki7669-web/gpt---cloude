# Postgres connection string (Neon/Supabase/etc)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign session cookies (generate a long random string)
AUTH_SECRET=change-me-to-a-long-random-string

# Facebook App credentials
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Shared secret the GitHub Actions heartbeat workflow sends to /api/heartbeat
HEARTBEAT_SECRET=change-me-too
